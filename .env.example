# =============================================================================
# CookHero Environment Variables
# =============================================================================
# This file contains all environment variables for the CookHero application.
# Copy this file to .env and fill in the actual values.
#
# IMPORTANT: Never commit the .env file to version control!
# =============================================================================

# =============================================================================
# 1. LLM API Configuration
# =============================================================================
# API keys for LLM providers. Keys are loaded from .env, never hardcoded.

# Primary LLM API Key (used by normal tier models)
# Required for main response generation
LLM_API_KEY=sk-your-primary-api-key-here

# Fast Model API Key (used by fast tier models)
# 与 LLM_API_KEY 属于同一服务商时留空即可，会自动继承
FAST_LLM_API_KEY=

# Vision/Multimodal API Key (for image analysis)
# 同上：同一服务商时留空自动继承 LLM_API_KEY
VISION_API_KEY=

# Reranker API Key (for result reranking)
RERANKER_API_KEY=sk-your-reranker-api-key-here

# =============================================================================
# 2. Web Search Configuration
# =============================================================================
# You.com API Key - Get from https://ydc-index.io/
# Used for both Search and Deep Research (replaces Tavily)
YOUCOM_API_KEY=ydc-your-youcom-api-key-here

# =============================================================================
# 3. Image Generation Configuration
# =============================================================================
# Image generation API Key (config.yml -> image_generation)
IMAGE_GENERATION_API_KEY=sk-your-image-generation-api-key-here

# imgbb API Key - persists generated/uploaded images (https://api.imgbb.com/)
IMGBB_STORAGE_API_KEY=your-imgbb-api-key-here

# =============================================================================
# 4. MCP (Model Context Protocol) Configuration
# =============================================================================
# Amap (高德地图) API Key - Get from https://console.amap.com/
AMAP_API_KEY=your-amap-api-key-here

# =============================================================================
# 5. Database Configuration
# =============================================================================
DATABASE_PASSWORD=your-secure-postgres-password-here
REDIS_PASSWORD=your-redis-password-here
MILVUS_USER=root
MILVUS_PASSWORD=your-milvus-password-here

# =============================================================================
# 6. Security & Authentication
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-must-be-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# 7. Rate Limiting Configuration
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_CONVERSATION_PER_MINUTE=30
RATE_LIMIT_GLOBAL_PER_MINUTE=100

# =============================================================================
# 8. Account Security Configuration
# =============================================================================
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MAX_MESSAGE_LENGTH=10000
MAX_IMAGE_SIZE_MB=5
# Rule-based prompt guard (no LLM call, always cheap to run)
PROMPT_GUARD_ENABLED=true

# NeMo Guardrails deep check (LLM-based, see app/security/guardrails/guard.py).
# Requires the nemoguardrails package and a valid FAST_LLM_API_KEY: every
# guarded request triggers an extra LLM call for the self-check.
GUARDRAILS_ENABLED=false

# =============================================================================
# 9. Offline / Network Configuration
# =============================================================================
# Set to 1 to skip HuggingFace Hub network probes. The embedding model
# (BAAI/bge-small-zh-v1.5) is cached locally after the first run, so this
# is required on restricted networks - without it startup can hang for a
# long time retrying huggingface.co.
HF_HUB_OFFLINE=1

# =============================================================================
# Image storage (self-hosted MinIO by default)
# =============================================================================
# provider: minio | imgbb. With minio, chat images never leave the deployment.
IMAGE_STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost:9001
MINIO_ACCESS_KEY=cookhero_minio
MINIO_SECRET_KEY=change-me-to-a-strong-password
MINIO_BUCKET=cookhero-media

# =============================================================================
# Session cookies / same-origin deployment
# =============================================================================
# Must be true in production behind HTTPS; false only for local http debugging
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://localhost:8443


# ==================== 后台写操作限流 ====================
# 每个 admin 账号每分钟允许的写操作次数（读操作另有 120/min 的桶）
RATE_LIMIT_ADMIN_WRITE_PER_MINUTE=20

# ==================== 告警通知 ====================
# 企业微信机器人或其他 webhook；留空则告警只落库不推送
ALERT_WEBHOOK_URL=
